PORT=4000
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=isp_ops
# Set true for Aiven / hosted MySQL (required)
DB_SSL=false
# Optional: path to CA PEM downloaded from Aiven console
# DB_SSL_CA=./ca.pem
JWT_SECRET=replace-with-a-long-random-secret
# Access JWT lifetime (short). Prefer JWT_ACCESS_EXPIRES_IN.
JWT_ACCESS_EXPIRES_IN=15m
# Legacy alias still read if ACCESS is unset
JWT_EXPIRES_IN=15m
# Refresh token lifetime in days
JWT_REFRESH_DAYS=7

